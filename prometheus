#syntax=docker/dockerfile:1

#Stage: pull Prometheus binary and consoles
FROM prom/prometheus:latest AS prom

#Final image: API + Prometheus (use remote API image)
FROM kenzodtu/mlops-api:latest

WORKDIR /app

#Copy Prometheus binary
COPY --from=prom /bin/prometheus /bin/prometheus

#Prometheus config (scrapes localhost:8000 inside this container)
COPY prometheus.single.yml /etc/prometheus/prometheus.yml

#Install prometheus-client in this combined image to enable metrics
RUN uv pip install prometheus-client

#Expose both ports: 8000 (API) and 9090 (Prometheus UI)
EXPOSE 8000 9090

#Enable metrics by default in this combined image
ENV ENABLE_METRICS=true

# Start API in background, then run Prometheus in foreground
CMD ["sh", "-c", "uv run uvicorn mlops_group_20.api:app --host 0.0.0.0 --port 8000 & exec /bin/prometheus --config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/prometheus --web.listen-address=:9090"]