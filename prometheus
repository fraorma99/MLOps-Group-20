#syntax=docker/dockerfile:1

#Stage: pull Prometheus binary and consoles
FROM prom/prometheus:latest AS prom

#Final image: API + Prometheus (use the new image with metrics support)
FROM kenzodtu/mlops-prometheus:latest

WORKDIR /app

#Copy Prometheus binary
COPY --from=prom /bin/prometheus /bin/prometheus

#Prometheus config (scrapes localhost:8000 inside this container)
COPY prometheus.single.yml /etc/prometheus/prometheus.yml

#Install prometheus-client in this combined image to enable metrics
RUN uv pip install prometheus-client

#Expose both ports: 8000 (API) and 9090 (Prometheus UI)
EXPOSE 8000 9090

#Enable metrics by default in this combined image
ENV ENABLE_METRICS=true

# Create a startup script that runs both services
RUN cat > /start.sh << 'EOF'
#!/bin/sh
# Start API in background with metrics enabled using uv run
uv run uvicorn mlops_group_20.api:app --host 0.0.0.0 --port 8000 &
API_PID=$!

# Wait a moment for API to start
sleep 3

# Start Prometheus in foreground
exec /bin/prometheus --config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/prometheus --web.listen-address=:9090
EOF
RUN chmod +x /start.sh

# Override entrypoint and use our startup script
ENTRYPOINT []
CMD ["/start.sh"]